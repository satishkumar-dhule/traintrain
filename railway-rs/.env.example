# railway-rs environment configuration
# Every variable is optional; the app runs with zero configuration.
# The values shown below are the built-in defaults.

# Port the HTTP server listens on
RAILWAY_PORT=3000

# Directory containing stations.json and trains.json
RAILWAY_DATA_DIR=./data

# Directory with the SPA static files
RAILWAY_STATIC_DIR=./static

# Timeout for outbound upstream HTTP requests, in seconds
RAILWAY_HTTP_TIMEOUT=15

# TTL for cached upstream responses, in seconds
RAILWAY_CACHE_TTL=120

# User-Agent header sent to upstream sources
RAILWAY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Base URL of the RailYatri upstream source
RAILWAY_SOURCE_RAILYATRI_BASE=https://www.railyatri.in

# Base URL of the etrain.info upstream source
RAILWAY_SOURCE_ETRAIN_BASE=https://etrain.info

# Base URL of the NTES (Indian Railways enquiry) upstream source
RAILWAY_SOURCE_NTES_BASE=https://enquiry.indianrail.gov.in

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Directory for rolling daily JSON log files (created if missing)
RAILWAY_LOG_DIR=./logs

# Console log format: json (default, structured one-object-per-line) or pretty
RAILWAY_LOG_FORMAT=json

# Structured log ring served live at /rail-api/logs (bounded in memory)
# - /metrics         Prometheus text format (scrape target for Grafana)
# - /rail-api/observability  Full JSON snapshot with time-series for charts
# - /rail-api/logs   Recent structured-log records (?limit=, ?level=)
