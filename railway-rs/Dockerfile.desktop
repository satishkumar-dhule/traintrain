# Full desktop Dockerfile for railway-rs + VNC/noVNC
# Build: docker build -f Dockerfile.desktop -t railway-rs:desktop .
# Run:   docker run -p 3000:3000 -p 6080:6080 -p 5901:5901 railway-rs:desktop
# Then open http://localhost:6080/vnc.html?autoconnect=1&resize=remote
# or VNC client to localhost:5901

# --- Builder ---
FROM rust:1-slim-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
RUN cargo build --release --locked

# --- Runtime with desktop ---
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PORT=3000 \
    VNC_PORT=5901 \
    NOVNC_PORT=6080 \
    DISPLAY=:1 \
    RESOLUTION=1280x800 \
    VNC_PW="" \
    RAILWAY_LOG_DIR=/tmp/railway-logs

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    # X server & VNC
    xvfb x11vnc xvnc4viewer \
    x11-xserver-utils x11-utils \
    # Window manager & desktop
    fluxbox openbox \
    tint2 \
    pcmanfm \
    lxappearance \
    papirus-icon-theme arc-theme \
    # Apps
    firefox-esr \
    chromium \
    xfce4-terminal thunar \
    rofi feh hsetroot \
    xdotool x11-apps \
    dbus-x11 \
    # noVNC + websockify
    novnc websockify \
    net-tools procps \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash railway \
    && mkdir -p /app/static /app/data /app/models /tmp/railway-logs \
    && chown -R railway:railway /app /tmp/railway-logs

WORKDIR /app
COPY --from=builder /app/target/release/railway-rs /app/railway-rs
COPY static/ /app/static/
COPY data/ /app/data/
COPY models/ /app/models/

# Desktop startup script
COPY <<'EOS' /usr/local/bin/start-desktop
#!/bin/bash
set -e
export DISPLAY=:1
RES=${RESOLUTION:-1280x800}
echo "[desktop] Starting Xvfb :1 -screen 0 ${RES}x24"
Xvfb :1 -screen 0 ${RES}x24 -ac +extension GLX +render -noreset &
sleep 1
echo "[desktop] Starting fluxbox"
fluxbox >/tmp/fluxbox.log 2>&1 &
sleep 1
# tint2 panel
tint2 >/tmp/tint2.log 2>&1 &
# pcmanfm desktop
pcmanfm --desktop >/tmp/pcmanfm.log 2>&1 &
# x11vnc
echo "[desktop] Starting x11vnc :1 -> 5901"
x11vnc -display :1 -nopw -forever -shared -rfbport 5901 -bg -o /tmp/x11vnc.log 2>&1 || true
# noVNC websockify 6080 -> 5901
echo "[desktop] Starting noVNC websockify 6080 -> 5901"
websockify --web /usr/share/novnc 6080 localhost:5901 >/tmp/novnc.log 2>&1 &
sleep 1
# wallpaper
hsetroot -solid "#0f172a" 2>/dev/null || xsetroot -solid "#0f172a" 2>/dev/null || true
# terminal
xfce4-terminal --geometry 90x24 2>/dev/null &
echo "[desktop] Desktop ready: VNC 5901, noVNC http://localhost:6080/vnc.html"
exec "$@"
EOS
RUN chmod +x /usr/local/bin/start-desktop

# Entrypoint that starts desktop + railway-rs
COPY <<'EOS' /usr/local/bin/entrypoint.sh
#!/bin/bash
set -e
# Start desktop in background
/usr/local/bin/start-desktop &
# Wait for X
for i in 1 2 3 4 5; do DISPLAY=:1 xdpyinfo >/dev/null 2>&1 && break; sleep 1; done
# Start railway-rs
echo "[app] Starting railway-rs on port ${PORT:-3000}"
exec /app/railway-rs
EOS
RUN chmod +x /usr/local/bin/entrypoint.sh

USER railway
EXPOSE 3000 5901 6080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://127.0.0.1:${PORT:-3000}/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
