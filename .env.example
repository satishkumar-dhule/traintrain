# RailCompanion runs with zero configuration - no API keys required.
#
# The app uses public, free data sources (Railyatri scraping for live PNR,
# schedule and live status) plus built-in mock sources for the demo endpoints.
#
# Optional: set NODE_ENV=production to serve the pre-built dist/ bundle
# instead of the Vite dev server middleware.
NODE_ENV="development"
