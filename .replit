modules = ["rust-stable", "web", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = [
  "linuxquota",
  "tint2",
  "feh",
  "rofi",
  "pcmanfm",
  "lxappearance",
  "arc-theme",
  "papirus-icon-theme",
  "xfce.xfce4-terminal",
  "xfce.thunar",
  "firefox",
  "chromium",
  "geany",
  "flameshot",
  "xdotool",
  "xorg.xrandr",
  "xorg.xset",
  "xorg.xrdb",
  "hsetroot",
  "nitrogen",
  "lxde.lxpanel",
  "openbox",
  "tigervnc",
  "novnc"
]

[agent]
expertMode = true

[run]
command = "export PATH=\"$HOME/.cargo/bin:$PATH\" && export CARGO_HOME=\"$HOME/.cargo\" && export RAILWAY_PORT=3000 && export RAILWAY_AI_BACKEND=local-first && export RAILWAY_LOCAL_THREADS=4 && cargo run --release"
workdir = "railway-rs"

[packager]
language = "rust"

[[ports]]
localPort = 1
externalPort = 4200

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3111
externalPort = 5173

[[ports]]
localPort = 3411
externalPort = 6000

[[ports]]
localPort = 3456
externalPort = 3001

[[ports]]
localPort = 3457
externalPort = 3002

[[ports]]
localPort = 3471
externalPort = 5000

[[ports]]
localPort = 4096
externalPort = 8000
exposeLocalhost = true

[[ports]]
localPort = 8799
externalPort = 3003

[[ports]]
localPort = 24678
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
